*.swp

# sistema
.DS_Store
Thumbs.db
# O projeto vive dentro do OneDrive, que semeia estes arquivos por pasta.
desktop.ini

# configuração local do agente (permissões da máquina, não do projeto).
# Atenção: `.claude/tasks/` e `.claude/skills/` SÃO versionados de propósito —
# são o plano de execução e as regras de processo do projeto, e o `CONTEXT.md`
# depende deles para fazer sentido.
.claude/settings.local.json

# Playwright: relatórios e rastros de execução (T17). Nenhum deles é fonte, e
# o rastro de uma falha carrega captura de tela da página — que num teste de
# cadastro é uma tela com dado de participante, ainda que inventado.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
