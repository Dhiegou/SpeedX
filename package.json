{
  "name": "speedx",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de cadastro e classificação de corrida — evento de um dia, dois Cockpits, 2000+ participantes",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio",
    "qr": "tsx scripts/gerar-qr.ts",
    "orcamento": "node scripts/orcamento.mjs",
    "criar-operador": "tsx scripts/criar-operador.ts",
    "expurgar": "tsx scripts/expurgar.ts",
    "metricas": "tsx scripts/metricas.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
